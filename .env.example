# Clé API Anthropic — obligatoire pour générer les résumés IA en direct.
# Récupérez-la sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# (Optionnel) Modèle Claude à utiliser. Par défaut : claude-haiku-4-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# (Optionnel) Forcer le mode cache strict, même avec une clé présente.
# VEILLE_PROD=1

# (Optionnel) Chemin custom vers data.db (utile si vous montez un volume).
# VEILLE_DB_PATH=/data/data.db
